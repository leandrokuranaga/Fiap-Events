{
  "ConnectionStrings": {
    "DefaultConnection": "Server=172.31.6.88;Database=FIAP;Username=postgres;Password=admin"
  },
  "EmailSender": "le.s.kuranaga@hotmail.com",
  "NameSender": "FIAP Events",
  "Subject": "FIAP Events Notification",
  "ServiceBus": {
    "Region": "sa-east-1",
    "LambdaQueueName": "lambda-queue"
  },
  "Metrics": {
    "Enabled": true,
    "Port": 0,
    "Endpoint": "/metrics"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Amazon": "Warning",
        "System": "Warning",
        "Prometheus": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "Uri": "http://localhost:3100"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ]
  },
  "DistributedTracing": {
    "Jaeger": {
      "ServiceName": "Lambda",
      "Endpoint": "http://ec2-54-207-227-213.sa-east-1.compute.amazonaws.com:14268/api/traces",
      "Host": "localhost",
      "Port": 6831
    }
  }
}